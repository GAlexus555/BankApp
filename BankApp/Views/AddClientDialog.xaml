<Window x:Class="BankApp.Views.AddClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neuer Kunde" Width="440" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A56DB" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Neuer Kunde" Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Kundenkonto anlegen" Foreground="#BFDBFE" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Name -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vorname" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="tbFirstName"/>
                        <TextBlock x:Name="errFirstName" Text="Min. 2 Zeichen erforderlich."
                                   Style="{StaticResource FieldError}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nachname" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="tbLastName"/>
                        <TextBlock x:Name="errLastName" Text="Min. 2 Zeichen erforderlich."
                                   Style="{StaticResource FieldError}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Email -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="E-Mail-Adresse" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="tbEmail"/>
                <TextBlock x:Name="errEmail" Text="Bitte gültige E-Mail-Adresse eingeben."
                           Style="{StaticResource FieldError}"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Passwort (min. 8 Zeichen)" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="pbPassword"/>
                <TextBlock x:Name="errPassword" Text="Passwort muss mindestens 8 Zeichen haben."
                           Style="{StaticResource FieldError}"/>
            </StackPanel>

            <!-- Phone -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Telefonnummer" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="tbPhone"/>
                <TextBlock x:Name="errPhone" Text="Bitte gültige Telefonnummer eingeben (min. 7 Ziffern)."
                           Style="{StaticResource FieldError}"/>
            </StackPanel>

            <!-- Address -->
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Adresse" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="tbAddress"/>
                <TextBlock x:Name="errAddress" Text="Adresse darf nicht leer sein."
                           Style="{StaticResource FieldError}"/>
            </StackPanel>

            <!-- Birthdate -->
            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <TextBlock Text="Geburtsdatum" Style="{StaticResource FormLabel}"/>
                <DatePicker x:Name="dpBirthdate"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource GhostButton}"
                        Width="110" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Erstellen" Width="110" Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
