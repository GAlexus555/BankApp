<UserControl x:Class="BankApp.Views.TransactionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankApp.Views"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Grid Margin="10" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Label Content="NEUE ÜBERWEISUNG"
               Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontSize="30"
               FontWeight="Bold"/>

        <Label Content="Von (IBAN): "
               Grid.Row="1" Grid.Column="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="10 0" FontSize="20"/>
        <Label Content="Zu (IBAN): "
               Grid.Row="2" Grid.Column="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="10 0" FontSize="20"/>
        <Label Content="Zweck: "
               Grid.Row="3" Grid.Column="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="10 0" FontSize="20"/>
        <Label Content="Gebühr: "
               Grid.Row="4" Grid.Column="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="10 0" FontSize="20"/>
        <Button Content="Zurück"
                Width="100"
                Grid.Row="5" Grid.Column="0"
                HorizontalAlignment="Center"
                Margin="15" FontSize="20"
                Command="{Binding Back}"/>
        <Button Content="Überweisen"
                Width="150"
                Grid.Row="5" Grid.Column="1"
                HorizontalAlignment="Center"
                Margin="15" FontSize="20"
                IsDefault="True"
                Command="{Binding NewTransaction}"/>

        <Label Content="{Binding IbanFrom}"
               Grid.Row="1" Grid.Column="1"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Margin="10 0" FontSize="20"
               Foreground="LightGray"/>

        <TextBox Grid.Row="2" Grid.Column="1"
                 Margin="10" VerticalContentAlignment="Center"
                 FontSize="20" Padding="10 0"
                 Text="{Binding IbanTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBox Grid.Row="3" Grid.Column="1"
                 Margin="10" VerticalContentAlignment="Center"
                 FontSize="20" Padding="10 0"
                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <local:AmountPicker Grid.Row="4" Grid.Column="1"
                            Margin="5 0"
                            AmountInCents="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</UserControl>
