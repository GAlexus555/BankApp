<UserControl x:Class="BankApp.Views.TransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:BankApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="64">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A56DB" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Left" Content="← Zurück"
                        Command="{Binding Back}"
                        Style="{StaticResource HeaderButton}"
                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Neue Überweisung" Foreground="White"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Form -->
        <Border Background="White" CornerRadius="0">
            <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- From IBAN (read-only) -->
                <TextBlock Grid.Row="0" Text="Von (IBAN)" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="1" Text="{Binding IbanFrom, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Courier New" Margin="0,0,0,16"/>

                <!-- To IBAN -->
                <TextBlock Grid.Row="2" Text="Empfänger IBAN" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="3"
                         Text="{Binding IbanTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Courier New" Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Grid.Row="4" Text="Verwendungszweck" Style="{StaticResource FormLabel}"/>
                <TextBox Grid.Row="5"
                         Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <!-- Amount + validation + submit -->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Betrag" Style="{StaticResource FormLabel}"/>
                    <local:AmountPicker Grid.Row="1"
                                        AmountInCents="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"/>

                    <!-- Validation error -->
                    <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ValidationError}"
                                   Foreground="#DC2626" FontSize="12"/>
                    </Border>

                    <!-- Submit button -->
                    <Button Grid.Row="3" Content="→  Überweisen"
                            Command="{Binding NewTransaction}"
                            HorizontalAlignment="Right"
                            Padding="24,10" FontSize="14"
                            IsDefault="True"/>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
