<UserControl x:Class="BankApp.Views.AmountPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BankApp.Views"
             mc:Ignorable="d" 
             Height="80">
    <Grid>
        <StackPanel Orientation="Horizontal">

            <!-- Euro -->
            <StackPanel Margin="5">
                <Button Content="▲" Click="EuroUp_Click"/>
                <TextBox x:Name="EuroTextBox"
                     Width="70"
                     Text="{Binding Euros, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="▼" Click="EuroDown_Click"/>
            </StackPanel>

            <TextBlock Text="€"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Margin="5"/>

            <!-- Cents -->
            <StackPanel Margin="5">
                <Button Content="▲" Click="CentUp_Click"/>
                <TextBox x:Name="CentTextBox"
                     Width="50"
                     Text="{Binding Cents, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Button Content="▼" Click="CentDown_Click"/>
            </StackPanel>

            <TextBlock Text="ct"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Margin="5"/>

        </StackPanel>
    </Grid>
</UserControl>
