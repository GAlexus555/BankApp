<Window x:Class="BankApp.Views.EditClientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kunde bearbeiten" Width="420" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="LightBlue" Padding="15,12">
            <TextBlock Text="Kunde bearbeiten" FontSize="18" FontWeight="SemiBold"/>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Vorname" Margin="0,0,0,2"/>
                    <TextBox x:Name="tbFirstName" Width="170"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Nachname" Margin="0,0,0,2"/>
                    <TextBox x:Name="tbLastName" Width="170"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="E-Mail" Margin="0,0,0,2"/>
                <TextBox x:Name="tbEmail"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Telefonnummer" Margin="0,0,0,2"/>
                <TextBox x:Name="tbPhone"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Adresse" Margin="0,0,0,2"/>
                <TextBox x:Name="tbAddress"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Speichern" Width="100" Background="LightBlue" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>