<Window x:Class="BankApp.Views.AddCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BankApp.Views"
        Title="Neue Karte" Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A56DB" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Neue Karte" Foreground="White" FontSize="17" FontWeight="Bold"/>
                <TextBlock Text="Bankkarte anlegen" Foreground="#BFDBFE" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Margin="22,18,22,16">

            <!-- IBAN -->
            <TextBlock Text="IBAN" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="tbIBAN" FontFamily="Courier New" Margin="0,0,0,4"/>
            <TextBlock x:Name="errIBAN" Text="IBAN muss 15–34 Zeichen haben (nur Buchstaben und Ziffern)."
                       Style="{StaticResource FieldError}" Margin="0,0,0,12"/>

            <!-- Card number + CVC -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kartennummer (13–16 Ziffern)" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="tbCardNr" FontFamily="Courier New" Margin="0,0,0,4"/>
                    <TextBlock x:Name="errCardNr" Text="Bitte 13–16 Ziffern eingeben."
                               Style="{StaticResource FieldError}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CVC" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="tbCVC" Margin="0,0,0,4"/>
                    <TextBlock x:Name="errCVC" Text="3–4 Ziffern."
                               Style="{StaticResource FieldError}"/>
                </StackPanel>
            </Grid>

            <!-- Expiry date -->
            <TextBlock Text="Ablaufdatum" Style="{StaticResource FormLabel}"/>
            <DatePicker x:Name="dpExpireDate" Margin="0,0,0,4"/>
            <TextBlock x:Name="errExpiry" Text="Ablaufdatum muss in der Zukunft liegen."
                       Style="{StaticResource FieldError}" Margin="0,0,0,12"/>

            <!-- Initial balance -->
            <TextBlock Text="Startguthaben" Style="{StaticResource FormLabel}"/>
            <local:AmountPicker x:Name="amountPicker" Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource GhostButton}"
                        Width="110" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Erstellen" Width="110" Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
