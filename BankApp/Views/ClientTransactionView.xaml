<UserControl x:Class="BankApp.Views.ClientTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="860">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel Background="{StaticResource BackgroundBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Height="64">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A56DB" Offset="0"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="12,0">
                <Button DockPanel.Dock="Left"
                        Content="← Zurück"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource HeaderButton}"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClientName}" Foreground="White"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ClientEmail}" Foreground="#BFDBFE" FontSize="12"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#FFFFFF26" CornerRadius="12"
                        Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Right"
                        Margin="0,0,8,0">
                    <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                        <Run Text="{Binding Transactions.Count, Mode=OneWay}"/>
                        <Run Text="Transaktion(en)"/>
                    </TextBlock>
                </Border>
            </DockPanel>
        </Border>

        <!-- Transaction table -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <ListView ItemsSource="{Binding Transactions}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Datum" Width="100"
                                        DisplayMemberBinding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}"/>
                        <GridViewColumn Header="Von" Width="170"
                                        DisplayMemberBinding="{Binding IBANFrom}"/>
                        <GridViewColumn Header="An" Width="170"
                                        DisplayMemberBinding="{Binding IBANTo}"/>
                        <GridViewColumn Header="Betrag" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountEuros, StringFormat='€ {0:F2}'}"
                                               HorizontalAlignment="Right" FontWeight="SemiBold"
                                               Foreground="#059669"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Beschreibung" Width="190"
                                        DisplayMemberBinding="{Binding Description}"/>
                        <GridViewColumn Header="Status" Width="90"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</UserControl>
