<UserControl x:Class="BankApp.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BankApp.Views"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <!-- Dark Sidebar -->
        <Grid Width="230" DockPanel.Dock="Left">
            <Grid.Background>
                <SolidColorBrush Color="#1E293B"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <DockPanel Grid.Row="0" Margin="16,20,16,12">
                <TextBlock DockPanel.Dock="Left" Text="💳" FontSize="22"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BankApp" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Verwaltung" Foreground="#475569" FontSize="11"/>
                </StackPanel>
            </DockPanel>

            <!-- Manager info chip -->
            <Border Grid.Row="1" Background="#0F1B2E" Margin="12,0,12,16"
                    Padding="10,8" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ANGEMELDET ALS" Foreground="#475569" FontSize="9" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Name}" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Navigation -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="ANSICHT" Style="{StaticResource SidebarSectionHeader}"/>
                    <Button Content="👥  Kunden"
                            Command="{Binding ShowClients}"
                            Style="{StaticResource SidebarNavButton}"/>
                    <Button Content="↔  Überweisungen"
                            Command="{Binding ShowTransactions}"
                            Style="{StaticResource SidebarNavButton}"/>

                    <Separator Style="{StaticResource SidebarDivider}"/>

                    <TextBlock Text="AKTIONEN" Style="{StaticResource SidebarSectionHeader}"/>
                    <Button Content="＋  Kunde hinzufügen"
                            Command="{Binding AddClientCommand}"
                            Style="{StaticResource SidebarNavButton}"/>
                    <Button Content="－  Kunde löschen"
                            Command="{Binding DeleteClientCommand}"
                            Style="{StaticResource SidebarNavButton}"/>
                    <Button Content="✎  Kunde bearbeiten"
                            Command="{Binding EditClientCommand}"
                            Style="{StaticResource SidebarNavButton}"/>
                    <Button Content="⊙  Transaktionen anzeigen"
                            Command="{Binding ViewClientTransactionsCommand}"
                            Style="{StaticResource SidebarNavButton}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Logout -->
            <Button Grid.Row="3"
                    Content="⏻  Abmelden"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource LogoutSidebarButton}"
                    HorizontalContentAlignment="Left"
                    Margin="0,4,0,16"/>
        </Grid>

        <!-- Client list -->
        <ListView Width="280" DockPanel.Dock="Left"
                  ItemsSource="{Binding Collection}"
                  SelectedItem="{Binding SelectedItem}"
                  BorderThickness="0,0,1,0">
        </ListView>

        <!-- Cards panel -->
        <local:ManagerCardsView/>
    </DockPanel>
</UserControl>
